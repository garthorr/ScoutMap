# Copy to .env next to docker-compose.yml and fill in.
# docker compose refuses to start without POSTGRES_PASSWORD.

# Required. Generate one with: openssl rand -hex 24
# Upgrading an existing install? Its database was created with the password
# "scoutmap" — either put that here, or change it first with:
#   docker compose exec db psql -U scoutmap -c "ALTER USER scoutmap PASSWORD 'new-password';"
POSTGRES_PASSWORD=

# Master admin password for the admin app (leave empty to turn password sign-in off)
ADMIN_PASSWORD=

# Seed list for email sign-in, e.g. "you@example.com,*@yourtroop.org"
ALLOWED_EMAILS=

# Email sign-in codes. Without SMTP_HOST, codes are written to the app log
# (fine for local testing, not for a real deployment).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=scoutmap@localhost
