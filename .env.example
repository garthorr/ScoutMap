# Copy to .env and fill in. docker compose refuses to start without POSTGRES_PASSWORD.

# Required: database password (generate with `openssl rand -hex 24`)
POSTGRES_PASSWORD=

# Optional: master admin password for the admin UI (leave empty to disable password login)
ADMIN_PASSWORD=

# Optional: comma-separated email allowlist seed, e.g. "you@example.com,*@yourtroop.org"
ALLOWED_EMAILS=

# Optional: SMTP for emailing login codes. If unset, codes are written to the
# app logs (development only — do not run production this way).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=scoutmap@localhost
